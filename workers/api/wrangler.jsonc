{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ybbf-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 4300,
    "ip": "localhost"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ybbf_db",
      "database_id": "b04f3fdc-06ee-4e9f-b1b8-af0fad6f45a0",
      "preview_database_id": "b04f3fdc-06ee-4e9f-b1b8-af0fad6f45a0"
    }
  ],

  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ]
}
