{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ybbf-media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 4400,
    "ip": "localhost"
  },
  "vars": {
    "MEDIA_PUBLIC_URL": "https://ybbf-media-worker.jbkim.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ybbf_db",
      "database_id": "b04f3fdc-06ee-4e9f-b1b8-af0fad6f45a0",
      "preview_database_id": "b04f3fdc-06ee-4e9f-b1b8-af0fad6f45a0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ybbf-storage",
      "preview_bucket_name": "ybbf-storage"
    }
  ]
}
